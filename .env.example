# ============================================================
# myTenant Invoice - Environment Configuration Template
# Author: CromStel IT Group
# Copy this file to .env.local and fill in actual values.
# NEVER commit real secrets to version control.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_URL=http://localhost:3000
APP_ENV=development
NODE_ENV=development

# ------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# Generate a secure random secret: openssl rand -hex 32
# ------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth

# OAuth Providers (optional)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ------------------------------------------------------------
# Database (MySQL 8+ with Prisma)
# ------------------------------------------------------------
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/mytenant_invoice"

# ------------------------------------------------------------
# Redis (caching, sessions, queues)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Email (Resend is recommended; SMTP fallback via Nodemailer)
# ------------------------------------------------------------
EMAIL_FROM="myTenant Invoice <no-reply@example.com>"
EMAIL_FROM_NAME="myTenant Invoice"
RESEND_API_KEY=

# SMTP fallback (used if RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------
# Object Storage (S3-compatible) for files, logos, documents
# ------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mytenant-invoice
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_ENDPOINT=

# ------------------------------------------------------------
# Payment Processing (Stripe)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# AI / LLM Provider (secure, tenant-scoped usage only)
# ------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# ------------------------------------------------------------
# Platform Super Admin Bootstrap
# ------------------------------------------------------------
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=
